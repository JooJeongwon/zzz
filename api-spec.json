{
    "openapi": "3.0.1",
    "info": {
        "title": "ZZZ Core Service API",
        "description": "ZZZ 프로젝트 Core Service API 문서",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "JWT": []
        }
    ],
    "tags": [
        {
            "name": "Chat API",
            "description": "채팅 관련 API"
        },
        {
            "name": "Couple API",
            "description": "커플 연결 및 조회 API"
        },
        {
            "name": "User API",
            "description": "유저 및 인증 관련 API"
        }
    ],
    "paths": {
        "/api/v1/users/status": {
            "post": {
                "tags": [
                    "User API"
                ],
                "summary": "상태 변경",
                "description": "유저의 상태(SLEEP, STUDY 등)를 수동으로 변경합니다.",
                "operationId": "updateStatus",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserStatusUpdateRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/users/register": {
            "post": {
                "tags": [
                    "User API"
                ],
                "summary": "회원가입",
                "description": "새로운 유저를 등록합니다.",
                "operationId": "register",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserRegisterRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/users/refresh": {
            "post": {
                "tags": [
                    "User API"
                ],
                "summary": "토큰 재발급",
                "description": "리프레시 토큰을 사용하여 액세스 토큰을 재발급받습니다.",
                "operationId": "refresh",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RefreshTokenRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/users/login": {
            "post": {
                "tags": [
                    "User API"
                ],
                "summary": "로그인",
                "description": "이메일과 비밀번호로 로그인하여 토큰을 발급받습니다.",
                "operationId": "login",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserLoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/users/heartbeat": {
            "post": {
                "tags": [
                    "User API"
                ],
                "summary": "하트비트 전송",
                "description": "앱이 활성화되어 있음을 서버에 알리고 배터리 정보를 갱신합니다.",
                "operationId": "heartbeat",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/HeartbeatRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/users/heartbeat/batch": {
            "post": {
                "tags": [
                    "User API"
                ],
                "summary": "오프라인 하트비트 일괄 전송",
                "description": "네트워크 연결 시 오프라인 동안 쌓인 하트비트 데이터를 일괄 전송합니다.",
                "operationId": "heartbeatBatch",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BatchHeartbeatRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/users/fcm-token": {
            "post": {
                "tags": [
                    "User API"
                ],
                "summary": "FCM 토큰 갱신",
                "description": "푸시 알림을 위한 FCM 토큰을 갱신합니다.",
                "operationId": "updateFcmToken",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/FcmTokenUpdateRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/couples/invite": {
            "post": {
                "tags": [
                    "Couple API"
                ],
                "summary": "초대 코드 생성",
                "description": "상대방을 초대하기 위한 코드를 생성합니다.",
                "operationId": "createInvite",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CoupleInviteResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/couples/connect": {
            "post": {
                "tags": [
                    "Couple API"
                ],
                "summary": "커플 연결",
                "description": "초대 코드를 입력하여 커플을 맺습니다.",
                "operationId": "connectCouple",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CoupleConnectRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/chat/send": {
            "post": {
                "tags": [
                    "Chat API"
                ],
                "summary": "메시지 전송",
                "description": "상대방에게 메시지를 전송합니다.",
                "operationId": "sendMessage",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SendMessageRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ChatMessage"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/couples/partner-status": {
            "get": {
                "tags": [
                    "Couple API"
                ],
                "summary": "상대방 상태 조회",
                "description": "연결된 상대방의 현재 상태 정보를 조회합니다.",
                "operationId": "getPartnerStatus",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PartnerStatusResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/chat/history": {
            "get": {
                "tags": [
                    "Chat API"
                ],
                "summary": "채팅 기록 조회",
                "description": "상대방과의 과거 채팅 내역을 페이징하여 조회합니다.",
                "operationId": "getChatHistory",
                "parameters": [
                    {
                        "name": "partnerId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 0
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageChatMessage"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "UserStatusUpdateRequest": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "변경할 상태 (ONLINE, SLEEP, STUDY, BUSY)",
                        "example": "SLEEP"
                    }
                },
                "description": "상태 변경 요청"
            },
            "UserRegisterRequest": {
                "required": [
                    "email",
                    "nickname",
                    "password"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "이메일",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "description": "비밀번호",
                        "example": "password123!"
                    },
                    "nickname": {
                        "type": "string",
                        "description": "닉네임",
                        "example": "Joo"
                    }
                },
                "description": "회원가입 요청"
            },
            "RefreshTokenRequest": {
                "type": "object",
                "properties": {
                    "refreshToken": {
                        "type": "string",
                        "description": "리프레시 토큰",
                        "example": "eyJh...123"
                    }
                },
                "description": "토큰 갱신 요청"
            },
            "TokenResponse": {
                "type": "object",
                "properties": {
                    "accessToken": {
                        "type": "string",
                        "description": "액세스 토큰",
                        "example": "eyJh...abc"
                    },
                    "refreshToken": {
                        "type": "string",
                        "description": "리프레시 토큰",
                        "example": "eyJh...xyz"
                    },
                    "userId": {
                        "type": "integer",
                        "description": "유저 ID",
                        "format": "int64",
                        "example": 1
                    }
                },
                "description": "인증 토큰 응답"
            },
            "UserLoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "이메일",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "description": "비밀번호",
                        "example": "password123!"
                    }
                },
                "description": "로그인 요청"
            },
            "HeartbeatRequest": {
                "type": "object",
                "properties": {
                    "batteryLevel": {
                        "type": "integer",
                        "description": "배터리 잔량(%)",
                        "format": "int32",
                        "example": 85
                    },
                    "isScreenOn": {
                        "type": "boolean",
                        "description": "화면 켜짐 여부",
                        "example": true
                    },
                    "timestamp": {
                        "type": "integer",
                        "description": "데이터 생성 시간(Epoch millis)",
                        "format": "int64",
                        "example": 1705647000000
                    }
                },
                "description": "하트비트(생존신호) 전송 요청"
            },
            "BatchHeartbeatRequest": {
                "type": "object",
                "properties": {
                    "heartbeats": {
                        "type": "array",
                        "description": "하트비트 리스트",
                        "items": {
                            "$ref": "#/components/schemas/HeartbeatRequest"
                        }
                    }
                },
                "description": "오프라인 동안 쌓인 하트비트 데이터 일괄 전송 요청"
            },
            "FcmTokenUpdateRequest": {
                "type": "object",
                "properties": {
                    "fcmToken": {
                        "type": "string",
                        "description": "FCM 디바이스 토큰",
                        "example": "d_k3l...123"
                    }
                },
                "description": "FCM 토큰 갱신 요청"
            },
            "CoupleInviteResponse": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "description": "초대 코드",
                        "example": "A1B2C3"
                    },
                    "expiresSeconds": {
                        "type": "integer",
                        "description": "만료 시간(초)",
                        "format": "int64",
                        "example": 86400
                    }
                },
                "description": "커플 초대 코드 응답"
            },
            "CoupleConnectRequest": {
                "required": [
                    "code"
                ],
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "description": "초대 코드",
                        "example": "A1B2C3"
                    }
                },
                "description": "커플 연결 요청"
            },
            "SendMessageRequest": {
                "type": "object",
                "properties": {
                    "receiverId": {
                        "type": "integer",
                        "description": "수신자 ID",
                        "format": "int64",
                        "example": 2
                    },
                    "content": {
                        "type": "string",
                        "description": "메시지 내용",
                        "example": "안녕, 자니?"
                    }
                },
                "description": "메시지 전송 요청"
            },
            "ChatMessage": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "senderId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "receiverId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "content": {
                        "type": "string"
                    },
                    "messageType": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "aiGenerated": {
                        "type": "boolean"
                    }
                }
            },
            "PartnerStatusResponse": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "integer",
                        "description": "유저 ID",
                        "format": "int64",
                        "example": 1
                    },
                    "nickname": {
                        "type": "string",
                        "description": "닉네임",
                        "example": "Joo"
                    },
                    "status": {
                        "type": "string",
                        "description": "현재 상태",
                        "example": "SLEEP",
                        "enum": [
                            "ONLINE",
                            "SLEEP",
                            "STUDY",
                            "BUSY",
                            "UNKNOWN",
                            "DISCHARGED"
                        ]
                    },
                    "lastActiveAt": {
                        "type": "string",
                        "description": "마지막 활동 시간",
                        "format": "date-time"
                    },
                    "batteryLevel": {
                        "type": "integer",
                        "description": "배터리 잔량",
                        "format": "int32",
                        "example": 85
                    }
                },
                "description": "상대방 상태 조회 응답"
            },
            "PageChatMessage": {
                "type": "object",
                "properties": {
                    "totalPages": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "totalElements": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ChatMessage"
                        }
                    },
                    "number": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "sort": {
                        "$ref": "#/components/schemas/SortObject"
                    },
                    "pageable": {
                        "$ref": "#/components/schemas/PageableObject"
                    },
                    "first": {
                        "type": "boolean"
                    },
                    "last": {
                        "type": "boolean"
                    },
                    "numberOfElements": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "empty": {
                        "type": "boolean"
                    }
                }
            },
            "PageableObject": {
                "type": "object",
                "properties": {
                    "offset": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "sort": {
                        "$ref": "#/components/schemas/SortObject"
                    },
                    "pageNumber": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "pageSize": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "paged": {
                        "type": "boolean"
                    },
                    "unpaged": {
                        "type": "boolean"
                    }
                }
            },
            "SortObject": {
                "type": "object",
                "properties": {
                    "empty": {
                        "type": "boolean"
                    },
                    "sorted": {
                        "type": "boolean"
                    },
                    "unsorted": {
                        "type": "boolean"
                    }
                }
            }
        },
        "securitySchemes": {
            "JWT": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}