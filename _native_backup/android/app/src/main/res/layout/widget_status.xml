<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="ZZZ Status"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <ImageButton
            android:id="@+id/btn_status_online"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/holo_green_light"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Online" />

        <ImageButton
            android:id="@+id/btn_status_sleep"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_light"
            android:src="@android:drawable/ic_lock_idle_low_battery"
            android:contentDescription="Sleep" />

        <ImageButton
            android:id="@+id/btn_status_study"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/holo_orange_light"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Study" />

        <ImageButton
            android:id="@+id/btn_status_busy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/holo_red_light"
            android:src="@android:drawable/ic_delete"
            android:contentDescription="Busy" />

    </LinearLayout>
    
    <TextView
        android:id="@+id/widget_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tap to update"
        android:textColor="@android:color/darker_gray"
        android:textSize="10sp"
        android:layout_marginTop="4dp"/>

</LinearLayout>
